# ---------------------------------------------------------------------------
# Carz Management — environment
# ---------------------------------------------------------------------------

# Which data provider backs the repositories.
#   memory   — in-process seeded store. Zero setup, great for demo/dev.
#   prisma   — any relational DB (Postgres, MySQL, SQLite) via Prisma.
#   firebase — Cloud Firestore.
# Switching this value is the ONLY change needed to move databases; all
# application code talks to the repository interfaces in src/lib/data/ports.
DATA_PROVIDER=memory

# Signing secret for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-secret-change-me-in-production-0000000000

# --- DATA_PROVIDER=prisma --------------------------------------------------
# Two URLs, because they are used for different things.
#
# DATABASE_URL is what the running app uses. On a host with a connection
# pooler (Neon, Supabase) this MUST be the *pooled* URL, or a serverless
# deployment opens a connection per invocation and exhausts the limit.
# On Neon the pooled host contains "-pooler".
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/carzz?sslmode=require"
#
# DIRECT_URL is used only by migrations, which issue DDL a pooler cannot run.
# It is the same database without "-pooler". Leave it unset on a plain
# Postgres server with no pooler; migrations then fall back to DATABASE_URL.
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/carzz?sslmode=require"

# --- DATA_PROVIDER=firebase ------------------------------------------------
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Public app metadata used by the PWA manifest.
NEXT_PUBLIC_APP_NAME="Carz Management"
