# ---------------------------------------------------------------------------
# Carz Management — environment
# ---------------------------------------------------------------------------

# Which data provider backs the repositories.
#   memory   — in-process seeded store. Zero setup, great for demo/dev.
#   prisma   — any relational DB (Postgres, MySQL, SQLite) via Prisma.
#   firebase — Cloud Firestore.
# Switching this value is the ONLY change needed to move databases; all
# application code talks to the repository interfaces in src/lib/data/ports.
DATA_PROVIDER=memory

# Signing secret for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=dev-only-secret-change-me-in-production-0000000000

# --- DATA_PROVIDER=prisma --------------------------------------------------
# DATABASE_URL="postgresql://user:password@localhost:5432/carzz?schema=public"

# --- DATA_PROVIDER=firebase ------------------------------------------------
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Public app metadata used by the PWA manifest.
NEXT_PUBLIC_APP_NAME="Carz Management"
